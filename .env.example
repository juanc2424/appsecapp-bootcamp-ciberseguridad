# Copiar a .env y completar. .env NO se versiona (ver .gitignore).

# El analizador corre en el host (venv), MobSF corre en Docker con el puerto
# publicado en localhost:8000.
MOBSF_URL=http://localhost:8000

# API key de MobSF. Sale en los logs del contenedor al primer arranque:
#   docker compose logs mobsf | grep -i "API Key"
# Se mantiene estable mientras no se borre el volumen mobsf_data.
MOBSF_API_KEY=

# Opcional: cuenta gratuita de VirusTotal (virustotal.com → perfil → API Key).
# Sin esto, el parámetro procedencia_reputacion queda sin evaluar (no rompe
# el pipeline). Límite: 4 req/min.
VT_API_KEY=

# Opcional: fallback a Google Play cuando apkeep no encuentra el APK en
# APKPure/F-Droid. Ver USAGE-google-play.md de EFForg/apkeep para obtener
# el aas_token (requiere una cuenta de Google, recomendable una secundaria).
GOOGLE_PLAY_EMAIL=
GOOGLE_PLAY_AAS_TOKEN=
